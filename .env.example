# The Sleeper league to ingest AND to answer for: src/ingest/sleeper.py,
# src/reasoning/recommend.py (questions + reports), and the evals all
# default their --league-id to this. Phase 5.1: recommend()/
# generate_report() verify the ingested data actually belongs to this
# league before answering.
SLEEPER_LEAGUE_ID=1389341490030862336

# Your roster_id within that league -- look it up in
# data/raw/sleeper/teams.json after running the Sleeper ingest. This is
# the single source of truth for resolving "my"-flavored questions (my
# roster, my quarterbacks, etc.) -- see src/rag/lookup.py:current_roster().
MY_ROSTER_ID=

# Required by src/reasoning/recommend.py (Phase 3) -- get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the model recommend.py uses. Defaults to a current
# Claude model (see src/reasoning/recommend.py's DEFAULT_MODEL) if unset.
ASKMADDEN_MODEL=
